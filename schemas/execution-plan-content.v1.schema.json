                  "kind": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "description": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            },
            "metadata": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {}
              }
            }
          }
        },
        "outputContract": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "roleOutputSchema",
            "finalResponseRules"
          ],
          "properties": {
            "roleOutputSchema": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {}
              }
            },
            "finalResponseRules": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "Return exactly one JSON object as the final response.",
                  "type": "string"
                },
                {
                  "const": "Do not wrap the JSON object in Markdown fences.",
                  "type": "string"
                },
                {
                  "const": "Use status `completed` only when the task output and every expected artifact are present.",
                  "type": "string"
                },
                {
                  "const": "Use `failed`, `blocked`, or `cancelled` with a structured error otherwise.",
                  "type": "string"
                },
                {
                  "const": "Artifact names and kinds must exactly match the task contract.",
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 5,
              "maxItems": 5
            }
          }
        }
      }
