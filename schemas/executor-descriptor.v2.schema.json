{
  "additionalProperties": false,
  "$id": "https://rolekit.dev/schemas/executor-descriptor.v2.json",
  "type": "object",
  "required": [
    "schema",
    "adapterProtocol",
    "adapterVersion",
    "id",
    "displayName",
    "transport",
    "capabilities",
    "features"
  ],
  "properties": {
    "schema": {
      "const": "rolekit/executor-descriptor@2",
      "type": "string"
    },
    "adapterProtocol": {
      "const": "rolekit/executor-adapter@1",
      "type": "string"
    },
    "adapterVersion": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "type": "string"
    },
    "transport": {
      "anyOf": [
        {
          "const": "cli",
          "type": "string"
        },
        {
          "const": "in-process",
          "type": "string"
        },
        {
          "const": "remote",
          "type": "string"
        }
      ]
    },
    "capabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "repository.read",
            "type": "string"
          },
          {
            "const": "repository.write",
            "type": "string"
          },
          {
            "const": "shell",
            "type": "string"
          },
          {
            "const": "web",
            "type": "string"
          },
          {
            "const": "vision",
            "type": "string"
          }
        ]
      }
    },
    "features": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "structuredOutput",
        "events",
        "cancellation",
        "contextIsolation",
        "supportedPathEnforcement",
        "permissionCombinations"
      ],
      "properties": {
        "structuredOutput": {
          "anyOf": [
            {
              "const": "native",
              "type": "string"
            },
            {
              "const": "prompt",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "events": {
          "type": "boolean"
        },
        "cancellation": {
          "anyOf": [
            {
              "const": "process",
              "type": "string"
            },
            {
              "const": "protocol",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "contextIsolation": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "userConfig",
            "projectInstructions",
            "projectResources",
            "environment",
            "credentials"
          ],
          "properties": {
            "userConfig": {
              "anyOf": [
                {
                  "const": "isolated",
                  "type": "string"
                },
                {
                  "const": "inherited",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            },
            "projectInstructions": {
              "anyOf": [
                {
                  "const": "isolated",
                  "type": "string"
                },
                {
                  "const": "inherited",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            },
            "projectResources": {
              "anyOf": [
                {
                  "const": "isolated",
                  "type": "string"
                },
                {
                  "const": "inherited",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            },
            "environment": {
              "anyOf": [
                {
                  "const": "minimal",
                  "type": "string"
                },
                {
                  "const": "inherited",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            },
            "credentials": {
              "anyOf": [
                {
                  "const": "explicit",
                  "type": "string"
                },
                {
                  "const": "user-store",
                  "type": "string"
                },
                {
                  "const": "inherited",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            }
          }
        },
        "supportedPathEnforcement": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "advisory",
                "type": "string"
              },
              {
                "const": "adapter",
                "type": "string"
              },
              {
                "const": "host",
                "type": "string"
              }
            ]
          }
        },
        "permissionCombinations": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  }
}
