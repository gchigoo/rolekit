{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rolekit/knowledge-entry@1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema",
    "id",
    "type",
    "title",
    "status",
    "tags",
    "created",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "rolekit/knowledge-entry@1",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "const": "rule",
          "type": "string"
        },
        {
          "const": "adr",
          "type": "string"
        },
        {
          "const": "learning",
          "type": "string"
        },
        {
          "const": "note",
          "type": "string"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "superseded",
          "type": "string"
        },
        {
          "const": "deprecated",
          "type": "string"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
