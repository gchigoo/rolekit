{
  "schema": "rolekit/task-contract@1",
  "id": "RK-20260728-DOG-CANCEL",
  "kind": "implementation",
  "role": "minimal-implementer",
  "executor": "pi",
  "objective": "Think carefully for several minutes about how to create src/dogfood-cancel.txt with exact text cancel-race, then create it. Take your time before any tool call.",
  "context": {
    "required_files": [
      "src/seed.txt"
    ],
    "docs": []
  },
  "scope": {
    "writable": [
      "src/**"
    ],
    "forbidden": [
      "**/.env*",
      "package.json"
    ]
  },
  "constraints": [
    "Only create the requested file"
  ],
  "deliverables": [
    "src/dogfood-cancel.txt"
  ],
  "acceptance": {
    "commands": [
      {
        "run": "node -e \"const fs=require('fs');const t=fs.readFileSync('src/dogfood-cancel.txt','utf8').trim();process.exit(t==='cancel-race'?0:1)\"",
        "expect_exit": 0
      }
    ],
    "assertions": [
      "src/dogfood-cancel.txt exists with exact content"
    ]
  },
  "execution": {
    "worktree": "isolated",
    "max_tool_calls": 20,
    "network": "allow",
    "timeout_minutes": 10
  },
  "escalation": {
    "on_scope_change": "return_blocked",
    "on_new_dependency": "require_approval",
    "on_ambiguous_requirement": "return_question"
  }
}
