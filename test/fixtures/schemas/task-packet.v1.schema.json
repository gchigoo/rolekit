{
  "additionalProperties": false,
  "$id": "https://rolekit.dev/schemas/task-packet.v1.json",
  "type": "object",
  "required": [
    "schema",
    "taskId",
    "roleId",
    "objective",
    "input",
    "context",
    "constraints",
    "acceptanceCriteria",
    "expectedArtifacts"
  ],
  "properties": {
    "schema": {
      "const": "rolekit/task-packet@1",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "parentTaskId": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "roleId": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "input": {},
    "context": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "const": "text",
                "type": "string"
              },
              {
                "const": "file",
                "type": "string"
              },
              {
                "const": "url",
                "type": "string"
              }
            ]
          },
          "value": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "repository.read",
            "type": "string"
          },
          {
            "const": "repository.write",
            "type": "string"
          },
          {
            "const": "shell",
            "type": "string"
          },
          {
            "const": "web",
            "type": "string"
          },
          {
            "const": "vision",
            "type": "string"
          }
        ]
      }
    },
    "allowedPaths": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "expectedArtifacts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
